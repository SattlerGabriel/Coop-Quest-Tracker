<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CoopQuestTracker.Client</AssemblyName>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <Managed>$(SptPath)/EscapeFromTarkov_Data/Managed</Managed>
  </PropertyGroup>

  <!-- Game, BepInEx and SPT DLLs straight from the install; none get copied to output -->
  <ItemGroup>
    <Reference Include="$(Managed)/Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(Managed)/Comfort.dll" Private="false" />
    <Reference Include="$(Managed)/Comfort.Unity.dll" Private="false" />
    <Reference Include="$(Managed)/Newtonsoft.Json.dll" Private="false" />
    <Reference Include="$(Managed)/Sirenix.Serialization.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.InputLegacyModule.dll" Private="false" />
    <Reference Include="$(Managed)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(SptPath)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(SptPath)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(SptPath)/BepInEx/plugins/spt/spt-common.dll" Private="false" />
    <Reference Include="$(SptPath)/BepInEx/plugins/spt/spt-reflection.dll" Private="false" />
  </ItemGroup>

</Project>
